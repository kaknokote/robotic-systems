<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ros_ai_assistant</name>
  <version>0.1.0</version>
  <description>ROS2 AI Assistant with OpenAI integration</description>

  <maintainer email="admin@example.com">ROS AI Team</maintainer>
  <license>MIT</license>

  <!-- build tool -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- messages / services -->
  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- ROS2 libs -->
  <build_depend>rclcpp</build_depend>
  <build_depend>rclpy</build_depend>
  <build_depend>std_msgs</build_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <!-- Python deps -->
  <exec_depend>python3-aiohttp</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-flask</exec_depend>
  <exec_depend>python3-flask-restful</exec_depend>

  <!-- объявляем, что пакет содержит msg/srv -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

